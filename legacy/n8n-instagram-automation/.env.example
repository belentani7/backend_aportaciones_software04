# Proveedor de generación de imagen o vídeo. Nunca subas valores reales al repositorio.
MEDIA_GENERATION_URL=https://api.example.com/v1/generations
MEDIA_GENERATION_API_KEY=replace_with_secure_secret
MEDIA_MODEL=replace_with_provider_model_id
MEDIA_CALLBACK_URL=https://n8n.example.com/webhook/media-completed

# Meta / Instagram Graph API. Configurar únicamente después de validar permisos oficiales.
META_GRAPH_VERSION=v23.0
INSTAGRAM_USER_ID=replace_with_professional_instagram_account_id
META_ACCESS_TOKEN=replace_with_secure_meta_access_token

# n8n. Protege el endpoint de aprobación con autenticación o firma.
N8N_APPROVAL_SHARED_SECRET=replace_with_a_long_random_value
N8N_TIMEZONE=Europe/Madrid
