APP_NAME=Money Machine 24H
APP_VERSION=1.0.0
DEBUG=false

HOST=0.0.0.0
PORT=8000

DATABASE_URL=sqlite:///./money_machine.db

CORS_ORIGINS=["*"]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=["*"]
